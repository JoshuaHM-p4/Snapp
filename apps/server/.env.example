PORT=4000
WEB_ORIGIN=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
DEMO_MODE=true
# Separate optional Velo Testnet checkout configuration (never client-side).
ADMIN_API_TOKEN=
VELO_API_KEY=
VELO_WEBHOOK_SECRET=
# Use one public Velo webhook endpoint: https://YOUR-SERVER/api/webhooks/velo
# Wallet sign-in (SEP-10). Generate with: node scripts/gen-auth-keys.mjs. AUTH_HOME_DOMAIN is the web host without scheme.
AUTH_SERVER_SECRET=
SESSION_SECRET=
AUTH_HOME_DOMAIN=localhost:5173
# Where the server keeps collections, runs and sessions. Render: /var/data (mounted disk). Local default: .data
DATA_DIR=
